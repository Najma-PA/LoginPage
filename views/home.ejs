<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      rel="stylesheet"
    />
    <style>
      body {
        background-color: #f8f9fa;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      }

      .navbar-brand {
        font-weight: 700;
        font-size: 1.5rem;
      }

      .dashboard-header {
        background: rgb(100, 61, 240);
        color: white;
        padding: 40px 0;
        margin-bottom: 50px;
        position: relative;
        overflow: hidden;
      }

      .card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 10px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        margin-bottom: 15px;
        overflow: hidden;
      }

      .card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
      }

      .card-icon {
        font-size: 3.5rem;
        margin-bottom: 1.5rem;
        opacity: 0.9;
      }

      .stats-card {
        text-align: center;
        padding: 40px 25px;
        border-bottom: 4px solid transparent;
        background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
      }

      .stats-card:nth-child(1) {
        border-bottom-color: #667eea;
      }
      .stats-card:nth-child(2) {
        border-bottom-color: #28a745;
      }
      .stats-card:nth-child(4) {
        border-bottom-color: #17a2b8;
      }

      .feature-icon {
        width: 70px;
        height: 70px;
        background: rgb(50, 122, 211);
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
      }

      .welcome-section {
        background: rgb(26, 21, 21);
        border-radius: 20px;
        padding: 30px;
        margin-bottom: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        border-left: 5px solid #667eea;
      }

      .user-avatar {
        width: 80px;
        height: 80px;
        background: rgb(100, 61, 240);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: rgb(255, 252, 252);
        margin: 0 auto 20px;
      }

      #signoutBtn {
        background-color: #dc3545;
        border: none;
        transition: 0.3s ease-in-out;
      }

      #signoutBtn:hover {
        background-color: #e35d6a;
        color: #fff;
      }
    </style>
  </head>
  <body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
      <div class="container">
        <a class="navbar-brand" href="#"
          >QueryChat <i class="fa-regular fa-comment"></i
        ></a>

        <div class="navbar-nav ms-auto">
          <div class="nav-item dropdown">
            <a
              class="nav-link dropdown-toggle text-white"
              href="#"
              role="button"
              data-bs-toggle="dropdown"
            >
              <i class="fas fa-user-circle me-1"></i> <%= username %>
            </a>
            <ul class="dropdown-menu">
              <li>
                <a class="dropdown-item" href="#"
                  ><i class="fas fa-cog me-2"></i>Settings</a
                >
              </li>
              <li>
                <a class="dropdown-item" href="#"
                  ><i class="fas fa-user me-2"></i>Profile</a
                >
              </li>
            </ul>
          </div>
        </div>
      </div>
    </nav>

    <!-- Dashboard Header -->
    <div class="dashboard-header">
      <div class="container text-center position-relative">
        <div class="user-avatar">
          <i class="fas fa-user"></i>
        </div>
        <h1 class="display-4 fw-bold mb-3">Welcome, <%= username %>!</h1>
      </div>
    </div>

    <!--Main Content -->
    <div class="container">
      <div class="row">
        <div class="col-md-4">
          <div class="card stats-card">
            <div class="card-icon text-primary">
              <i class="fas fa-chart-line"></i>
            </div>
            <h2 class="fw-bold">1,234</h2>
            <p class="text-muted mb-0">Total Visits</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card stats-card">
            <div class="card-icon text-success">
              <i class="fas fa-users"></i>
            </div>
            <h2 class="fw-bold">567</h2>
            <p class="text-muted mb-0">Active Users</p>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card stats-card">
            <div class="card-icon text-info">
              <i class="fas fa-comments"></i>
            </div>
            <h2 class="fw-bold">23</h2>
            <p class="text-muted mb-0">Messages</p>
          </div>
        </div>
      </div>
      <div class="row mt-4">
        <div class="col-12 d-flex justify-content-center">
          <form action="/logout" method="POST">
            <button
              id="signoutBtn"
              type="submit"
              class="btn btn-danger text-white px-5 py-3 rounded"
            >
              Sign Out
            </button>
          </form>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Prevent back button after logout -->
    <script>
      history.pushState(null, null, location.href);
      window.onpopstate = function () {
        history.go(1);
      };

      // Session status check
      setInterval(() => {
        fetch("/api/session-status")
          .then((response) => response.json())
          .then((data) => {
            if (!data.isAuthenticated) {
              window.location.href = "/";
            }
          })
          .catch(() => {
            window.location.href = "/";
          });
      }, 60000); // Check every minute
    </script>
  </body>
</html>
